# Cổng khởi chạy Server FastAPI
PORT=8000
HOST=0.0.0.0

# Khóa bí mật JWT
JWT_SECRET=super_secret_jwt_key_dacn_python_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Đường dẫn CSDL SQLite
DATABASE_PATH=data/revenue_system.sqlite

# GOOGLE GEMINI API KEY
# Lấy API Key miễn phí tại: https://aistudio.google.com/
# Khi đẩy lên GitHub: KHÔNG BAO GIỜ GÁN KEY THẬT VÀO ĐÂY!
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash
