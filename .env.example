# ==========================================================
# CẤU HÌNH HỆ THỐNG PHÂN TÍCH DOANH THU & AI (PYTHON FASTAPI)
# File này mẫu công khai an toàn để đưa lên GitHub
# Hướng dẫn: Copy file này thành .env và điền thông tin của máy bạn
# ==========================================================

# Cổng khởi chạy Server FastAPI
PORT=8000
HOST=127.0.0.1

# ==========================================================
# CẤU HÌNH CƠ SỞ DỮ LIỆU (DATABASE CONFIGURATION)
# ==========================================================
# Chọn 'mssql' (Microsoft SQL Server) hoặc 'sqlite'
DB_TYPE=mssql
DB_POOL_SIZE=10
DB_POOL_TIMEOUT=30

# 1. Dành cho Microsoft SQL Server (SSMS):
# - DB_DATABASE: Giữ nguyên mặc định 'RevenueSystemDB' (khớp với file database_mssql.sql)
# - DB_SERVER: localhost, ., 127.0.0.1 hoặc .\SQLEXPRESS (nếu máy cài bản SQL Server Express)
# - DB_TRUSTED_CONNECTION: 'yes' (Windows Authentication) hoặc điền DB_USER / DB_PASSWORD (nếu dùng sa)
DB_SERVER=localhost
DB_DATABASE=RevenueSystemDB
DB_TRUSTED_CONNECTION=yes
# DB_USER=sa
# DB_PASSWORD=your_password_here

# 2. Dành cho SQLite (Nếu chọn DB_TYPE=sqlite - Không cần cài SQL Server):
DATABASE_PATH=data/revenue_system.sqlite

# ==========================================================
# BẢO MẬT JWT & GOOGLE GEMINI AI
# ==========================================================
JWT_SECRET=super_secret_jwt_key_dacn_python_2026
DEBUG_MODE=false
# Set true when serving the application over HTTPS in production.
COOKIE_SECURE=false
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# GOOGLE GEMINI API KEY
# Lấy API Key miễn phí tại: https://aistudio.google.com/
# Khi đẩy lên GitHub: KHÔNG BAO GIỜ GÁN KEY THẬT VÀO ĐÂY!
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.5-flash
